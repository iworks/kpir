# ─── Build artifacts ──────────────────────────────────────────────────────────
# Compiled CSS/JS — regenerated by `bun run css` / `bun run js`.
assets/styles/*.css
assets/scripts/admin/*.js

# Bundler / release output.
release/
*.tmp

# ─── Dev tool caches ──────────────────────────────────────────────────────────
.sass-cache
node_modules

# ─── Logs & reports ───────────────────────────────────────────────────────────
# Plugin Check (PCP) results from `bun run pcp`, and any other local logs.
*.log

# ─── Dependencies & lockfiles ─────────────────────────────────────────────────
# PHP dev dependencies (PHPUnit) — restored with `composer install`.
vendor/
composer.lock
package-lock.json

# ─── Local environment & editor junk ──────────────────────────────────────────
local.*
.playwright-mcp/
prepros.json
.smbdelete*
tests/php/readme.txt

# ─── Local tooling (downloaded, not committed) ────────────────────────────────
wp-cli.phar

# ─── Compiled ─────────────────────────────────────────────────────────────────
languages/*.mo
